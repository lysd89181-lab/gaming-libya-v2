rules_version = '2';
// قواعد يوم الإطلاق: الموقع الجديد ما يستعملش Firestore من المتصفح أبداً.
// كل القراءة والكتابة تمر من الـ Worker بمفتاح السيرفر (اللي يتجاوز القواعد).
// تركيب هذي القواعد يقفل كل الثغرات، ويوقف الموقع القديم.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
